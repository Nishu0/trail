# Required: Neon pooled PostgreSQL connection URL. Keep this server-side.
DATABASE_URL=
# Optional workspace UUID; default is your personal workspace.
TRAIL_WORKSPACE_ID=4d063d79-f44f-4a32-b56e-1ac8e8f402a7

# Optional, increases GitHub's API limit. Public repos work without a token.
GITHUB_TOKEN=
# Optional, enables style-aware AI drafts through Vercel AI Gateway.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.4
# Optional, résumé autofill with Claude Haiku 5.5 (direct Anthropic API).
ANTHROPIC_API_KEY=

# Optional, company and people research using Exa.
EXA_API_KEY=
# Optional, public LinkedIn profile and job discovery using Brave Search.
BRAVE_SEARCH_API_KEY=
